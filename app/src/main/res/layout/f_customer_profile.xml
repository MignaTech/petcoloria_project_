 <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    tools:context="com.android.usecases.menu.fragments.f_customer_profile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/fui_wrapper_padding_horiz"
        android:orientation="vertical"
        tools:ignore="UselessParent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="200dp"
            android:background="@drawable/border_rounded_button">

            <LinearLayout
                android:id="@+id/btn_return_profile_mc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="TODO"
                    android:src="@drawable/img_vector"
                    app:tint="@color/green_534"
                    tools:ignore="ImageContrastCheck" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="5dp"
                    android:text="Perfil"
                    android:textAllCaps="false"
                    android:textColor="@color/colorAccent"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image_mc"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/img_user_icon"
                app:civ_border_color="@color/gray"
                app:civ_border_width="2dp" />

            <LinearLayout
                android:id="@+id/btn_edit_image_mc"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="165dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/img_edit_icon"
                    app:tint="@color/blue" />

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Cambiar Foto"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/blue"
                    android:textSize="12sp" />
            </LinearLayout>
            <EditText
                android:id="@+id/name_user_customer_mc"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:enabled="false"
                android:background="@null"
                android:layout_marginTop="70dp"
                android:layout_marginStart="135dp"
                android:text="name user"
                android:textAllCaps="false"
                android:textColor="@color/colorAccent"
                android:textSize="18dp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/type_user_customer_mc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="90dp"
                android:layout_marginStart="135dp"
                android:text="Tipo usuario"
                android:textAllCaps="false"/>

            <LinearLayout
                android:id="@+id/btn_edit_customer"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="135dp"
                android:layout_marginTop="110dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar"
                    android:textAllCaps="false"
                    android:textColor="#1976D2" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/img_edit_icon"
                    app:tint="@color/blue" />
            </LinearLayout>
        </FrameLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/border_rounded_button"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:text="Teléfono: "/>
                <EditText
                    android:id="@+id/phone_customer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="phone "
                    android:enabled="false"
                    android:textColor="@color/black"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height=".5dp"
                android:background="@color/black"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:text="Domicilio: "/>

                <EditText
                    android:id="@+id/address_customer"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:enabled="false"
                    android:text="domicilio"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height=".5dp"
                android:background="@color/black" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:text="Correo: "/>
                <EditText
                    android:id="@+id/email_customer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="email"
                    android:enabled="false"
                    android:textColor="@color/black" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height=".5dp"
                android:background="@color/black" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center">
                <Button
                    android:id="@+id/btn_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/red"
                    android:text="Eliminar Cuenta"
                    android:visibility="visible" />
                <Button
                    android:id="@+id/btn_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/green"
                    android:text="Actualizar Datos"
                    android:visibility="invisible" />
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>