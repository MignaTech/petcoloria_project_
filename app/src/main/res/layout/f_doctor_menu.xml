<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    tools:context="com.android.usecases.menu.fragments.f_doctor_menu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/fui_wrapper_padding_horiz"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileimage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/gray"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/nameuser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:layout_marginStart="135dp"
                android:text="Name user"
                android:textAllCaps="false"
                android:textColor="@color/colorAccent"
                android:textSize="18dp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/typeuser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="90dp"
                android:layout_marginStart="135dp"
                android:text="Médico Veterinario"
                android:textAllCaps="false"/>
        </FrameLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/solicitud"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/border_rounded_button"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="40dp"
                    android:src="@drawable/img_notification_icon"
                    app:tint="@color/orange"/>
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="20dp"
                    android:layout_gravity="center"
                    android:text="solicitudes"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:id="@+id/perfil"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/border_rounded_button"
                android:orientation="vertical"
                android:radius="50dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="40dp"
                    android:src="@drawable/img_user_icon"
                    app:tint="@color/blue" />
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="20dp"
                    android:layout_gravity="center"
                    android:text="Perfil"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

        </LinearLayout>

        <Space
            android:layout_width="20dp"
            android:layout_height="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <LinearLayout
                android:id="@+id/citas"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/border_rounded_button"
                android:orientation="vertical"
                app:cornerRadius="5dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/img_date_icon"
                    app:tint="@color/green" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:textAlignment="center"
                    android:text="Citas"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>


        </LinearLayout>

        <Space
            android:layout_width="20dp"
            android:layout_height="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/guia"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/border_rounded_button"
                android:orientation="vertical"
                app:cornerRadius="5dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="47dp"
                    android:src="@drawable/img_guide_icon"
                    app:tint="@color/teal_200" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="20dp"
                    android:layout_gravity="center"
                    android:text="Guía"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:background="@drawable/border_rounded_button"
                android:orientation="vertical"
                app:cornerRadius="5dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="47dp"
                    android:src="@drawable/img_logout_icon"
                    app:tint="@color/violet" />

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="5dp"
                    android:layout_gravity="center"
                    android:text="Cerrar Sesión"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>